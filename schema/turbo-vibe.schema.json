{
  "$id": "https://unpkg.com/@turbo-vibe/cli@1/schema/turbo-vibe.schema.json",
  "title": "turbo-vibe.yaml",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "const": 1
    },
    "project": {
      "type": "string",
      "pattern": "^[a-z]([a-z0-9-]{0,61}[a-z0-9])?$"
    },
    "domain": {
      "type": "string",
      "pattern": "^(?=.{1,253}$)([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z]{2,63}$"
    },
    "previews": {
      "type": "boolean"
    },
    "environments": {
      "type": "object",
      "properties": {
        "staging": {
          "type": "object",
          "properties": {
            "hostname": {
              "type": "string",
              "pattern": "^(?=.{1,253}$)([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z]{2,63}$"
            },
            "api_hostname": {
              "type": "string",
              "pattern": "^(?=.{1,253}$)([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z]{2,63}$"
            },
            "access": {
              "type": "object",
              "properties": {
                "emails": {
                  "minItems": 1,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[^@\\s]+@([A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?\\.)+[A-Za-z]{2,63}$"
                  }
                }
              },
              "required": [
                "emails"
              ],
              "additionalProperties": false
            },
            "analytics": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        "production": {
          "type": "object",
          "properties": {
            "hostname": {
              "type": "string",
              "pattern": "^(?=.{1,253}$)([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z]{2,63}$"
            },
            "api_hostname": {
              "type": "string",
              "pattern": "^(?=.{1,253}$)([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z]{2,63}$"
            },
            "access": {
              "type": "object",
              "properties": {
                "emails": {
                  "minItems": 1,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[^@\\s]+@([A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?\\.)+[A-Za-z]{2,63}$"
                  }
                }
              },
              "required": [
                "emails"
              ],
              "additionalProperties": false
            },
            "analytics": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "services": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z]([a-z0-9-]{0,61}[a-z0-9])?$"
      },
      "additionalProperties": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "backend"
              },
              "target": {
                "type": "string",
                "enum": [
                  "cloudflare-container"
                ]
              },
              "secrets": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "paths": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^\\/([A-Za-z0-9._~-]+\\/)*$"
                }
              },
              "build": {
                "type": "object",
                "properties": {
                  "dockerfile": {
                    "type": "string",
                    "minLength": 1
                  },
                  "context": {
                    "type": "string",
                    "minLength": 1
                  },
                  "test": {
                    "type": "string",
                    "minLength": 1
                  },
                  "secrets": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "required": [
                  "dockerfile"
                ],
                "additionalProperties": false
              },
              "container": {
                "type": "object",
                "properties": {
                  "instance_type": {
                    "type": "string",
                    "enum": [
                      "lite",
                      "basic",
                      "standard-1",
                      "standard-2",
                      "standard-3",
                      "standard-4"
                    ]
                  },
                  "sleep_after": {
                    "type": "string",
                    "pattern": "^[1-9][0-9]*(s|m|h)$"
                  },
                  "max_instances": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 9007199254740991
                  },
                  "health": {
                    "type": "string",
                    "pattern": "^\\/(?!\\/)[^\\s?#]*$"
                  },
                  "port": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 65535
                  },
                  "instance_from": {
                    "type": "string",
                    "pattern": "^(query|header):[A-Za-z0-9_-]+$"
                  }
                },
                "additionalProperties": false
              }
            },
            "required": [
              "kind",
              "target",
              "build"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "frontend"
              },
              "target": {
                "type": "string",
                "enum": [
                  "cloudflare-static",
                  "vercel-static",
                  "vercel-nextjs"
                ]
              },
              "secrets": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "public": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "serve_with": {
                "type": "string",
                "pattern": "^[a-z]([a-z0-9-]{0,61}[a-z0-9])?$"
              },
              "not_found": {
                "type": "string",
                "enum": [
                  "spa",
                  "404-page"
                ]
              },
              "build": {
                "type": "object",
                "properties": {
                  "command": {
                    "type": "string",
                    "minLength": 1
                  },
                  "output": {
                    "type": "string",
                    "minLength": 1
                  },
                  "root": {
                    "type": "string",
                    "minLength": 1
                  },
                  "test": {
                    "type": "string",
                    "minLength": 1
                  },
                  "secrets": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "required": [
                  "command"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "kind",
              "target",
              "build"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "database"
              },
              "target": {
                "type": "string",
                "enum": [
                  "supabase"
                ]
              },
              "organization": {
                "type": "string",
                "minLength": 1
              },
              "region": {
                "type": "string",
                "minLength": 1
              },
              "plan": {
                "type": "string",
                "enum": [
                  "free",
                  "paid"
                ]
              },
              "staging": {
                "type": "string",
                "enum": [
                  "project",
                  "branch"
                ]
              },
              "workdir": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "kind",
              "target",
              "region"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "identity"
              },
              "target": {
                "type": "string",
                "enum": [
                  "workos"
                ]
              },
              "callback_path": {
                "default": "/api/auth/callback",
                "type": "string",
                "pattern": "^\\/[A-Za-z0-9/_-]*$"
              }
            },
            "required": [
              "kind",
              "target"
            ],
            "additionalProperties": false
          }
        ]
      }
    }
  },
  "required": [
    "version",
    "project",
    "domain",
    "services"
  ],
  "additionalProperties": false
}
