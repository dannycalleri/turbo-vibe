{
  "name": "@turbo-vibe/cli",
  "version": "1.0.0-rc.3",
  "description": "Life after localhost: take your prototype to production. Staging and production from one yaml file, in your own Cloudflare, Vercel, Supabase and WorkOS accounts; a person promotes the build that passed staging.",
  "keywords": [
    "deploy",
    "deployment",
    "cli",
    "staging",
    "production",
    "preview-environments",
    "github-actions",
    "cloudflare",
    "cloudflare-workers",
    "vercel",
    "nextjs",
    "supabase",
    "workos",
    "opentofu",
    "infrastructure-as-code",
    "vibe-coding",
    "claude-code"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dannycalleri/turbo-vibe.git"
  },
  "homepage": "https://github.com/dannycalleri/turbo-vibe#readme",
  "type": "module",
  "bin": {
    "turbo-vibe": "dist/cli.js"
  },
  "files": [
    "dist",
    "infra/**/*.tf",
    "schema",
    "npm-shrinkwrap.json"
  ],
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "check": "make check",
    "validate:infra": "make validate-infra"
  },
  "dependencies": {
    "@cloudflare/containers": "0.3.7",
    "aws4fetch": "1.0.20",
    "commander": "15.0.0",
    "postgres": "3.4.9",
    "supabase": "2.120.0",
    "vercel": "63.1.0",
    "wrangler": "4.148.0",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "26.6.4",
    "msw": "3.0.2",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "ignoredBuiltDependencies": [
      "workerd"
    ]
  },
  "packageManager": "pnpm@10.26.2",
  "overrides": {
    "@vercel/oidc": {
      "jose": "5.9.6"
    }
  },
  "volta": {
    "node": "24.12.0"
  }
}
