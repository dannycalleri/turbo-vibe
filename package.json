{
  "name": "@turbo-vibe/cli",
  "version": "0.0.0",
  "description": "Deploy any project from one config file.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "turbo-vibe": "dist/cli.js"
  },
  "files": [
    "dist",
    "infra/**/*.tf"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "check": "make check",
    "validate:infra": "make validate-infra"
  },
  "dependencies": {
    "@cloudflare/containers": "0.3.7",
    "commander": "15.0.0",
    "postgres": "3.4.9",
    "supabase": "2.120.0",
    "wrangler": "4.148.0",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "26.6.4",
    "tsup": "8.5.1",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "ignoredBuiltDependencies": [
      "workerd"
    ]
  },
  "packageManager": "pnpm@10.26.2"
}
